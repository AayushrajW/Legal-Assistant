rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /cases/{caseId} {
      allow read, write: if request.auth != null && resource.data.citizenId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.citizenId == request.auth.uid;
      match /{document=**} {
        allow read, write: if request.auth != null &&
          get(/databases/$(database)/documents/cases/$(caseId)).data.citizenId == request.auth.uid;
      }
    }
    match /lawyers/{lawyerId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
